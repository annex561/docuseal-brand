<% brand = Current.brand || (defined?(request) ? Brand.for_host(request.host) : Brand.new(Brand::BRANDS_CONFIG['default'])) %>
<title>
  <%= turbo_native_app? ? content_for(:native_title) : (content_for(:html_title) || (signed_in? ? brand.name : "#{brand.name} | Open Source Document Signing")) %>
</title>
<%= render 'shared/meta' %>
<% if turbo_native_app? %>
  <meta name="turbo-cache-control" content="no-preview">
  <%= render 'layouts/native_styles' %>
<% end %>
